PORT=3000

# URL-encode special characters in the password (e.g. @ -> %40).
# Supabase: pg treats sslmode=require as verify-full, which rejects Supabase's
# own CA, so append ?sslmode=no-verify.
STYLE_WORK_DB_URL=postgresql://postgres:your_password@localhost:5432/lead_tracker

# Optional. Enables the PostgreSQL tests, which run in a temporary schema, so
# this can be the same URL as STYLE_WORK_DB_URL.
# TEST_DATABASE_URL=

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (1 behind nginx), so rate
# limiting sees the real client IP. Leave unset when running locally.
# TRUST_PROXY=1
