# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on (hosting platforms usually set this for you).
PORT=3000

# PostgreSQL connection string:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
# Supabase: use the "Session pooler" string and append ?sslmode=no-verify
# (pg treats sslmode=require as verify-full, which rejects Supabase's own CA).
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/lead_tracker

# Optional: enables the PostgreSQL tests (`npm test`). They run in a temporary
# schema that is dropped afterwards, so this can be the same URL as DATABASE_URL.
# Leave it unset to skip them.
# TEST_DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API (CORS).
# Local Vite dev server by default; add your deployed frontend URL in production.
CORS_ORIGIN=http://localhost:5173
